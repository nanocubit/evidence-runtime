{
  "metadata": {
    "name": "evidence_runtime_l1_v2",
    "version": "2.1",
    "created": "2026-08-08",
    "purpose": "L1 HTTP extraction completeness — live URLs only, class-specific schemas",
    "design_principles": [
      "All URLs verified HTTP 200/202 at build time",
      "Product = real PDP (not category/marketing hub without price)",
      "SPA schema has no dynamic_content (requires L3)",
      "expected_l1 is documentation only, not ground truth",
      "No dead news URLs from 2023"
    ],
    "classes": {
      "article": 8,
      "product": 8,
      "docs": 8,
      "reference": 8,
      "spa": 8
    },
    "n_items": 40,
    "ground_truth_status": "none",
    "updated": "2026-08-08",
    "notes": "v2.1: bot-wall URL replaced, optional fields for known L1 ceilings; 2026-08-17: SciAm→css-tricks, k8s hub→v1.32 post",
